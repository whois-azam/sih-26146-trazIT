# =============================================================================
# TrazIT / BTC Forensics — .gitignore
# =============================================================================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
venv/
env/
.venv/
.env/

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# =============================================================================
# LARGE RUNTIME ASSETS — kept locally, not committed to GitHub
# Anyone cloning must download these separately (see README for instructions)
# =============================================================================

# GGUF / LLM model (1.2 GB) — download separately, see llm/llm_README.md
llm/models/*.gguf
llm/models/*.bin

# GeoIP databases (MaxMind GeoLite2, ~20 MB total)
geoip/data/*.mmdb

# Trained ML artifacts — large binary files regenerated by running the pipeline
# ml/artifacts/ is intentionally excluded; the source code to regenerate is included
ml/artifacts/isolation_forest.joblib
ml/artifacts/preprocessor.joblib
ml/artifacts/score_reference.npy

# =============================================================================
# LARGE GENERATED DATA FILES — not part of source
# =============================================================================

# Raw 100k training dataset and associated outputs (34+ MB)
data/raw/bitcoin_dataset_100k.csv
data/raw/ground_truth.json
data/raw/network_observations.csv
data/raw/network_observation_eval_truth.csv
data/raw/network_observation_eval_truth.json

# Processed/derived large files
data/processed/correlations_direct.csv
data/processed/correlations_fallback.csv
data/processed/risk_scores.csv
data/processed/behavioral_clusters.csv
data/processed/graph_centrality.json
data/processed/graph_communities.json
data/processed/graph_summary.json

# =============================================================================
# DOCKER / DEPLOYMENT PACKAGING — local deployment artifacts, not source
# =============================================================================

# Entire Linux deployment package (includes 1.57 GB .tar image)
Linux form/

# Docker-related
*.tar
Dockerfile
.dockerignore

# =============================================================================
# PRIVATE / FINAL DOCUMENTATION — kept locally
# =============================================================================

Final Doc/

# =============================================================================
# LOGS / TEMP
# =============================================================================
*.log
*.tmp
*.bak
.cache/
